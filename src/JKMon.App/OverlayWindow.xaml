<Window x:Class="JKMon.App.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="JKMon"
        SizeToContent="Manual"
        Width="520"
        Height="56"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Focusable="False"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <!-- The caption sits outside the Border so the background never extends up behind it. -->
    <StackPanel x:Name="Shell"
                Orientation="Vertical"
                HorizontalAlignment="Left"
                VerticalAlignment="Top">

        <TextBlock x:Name="CustomTextBlock"
                   Visibility="Collapsed"
                   HorizontalAlignment="Center"
                   TextWrapping="NoWrap" />

        <Border x:Name="Panel"
                CornerRadius="8"
                Padding="12,7"
                HorizontalAlignment="Left"
                VerticalAlignment="Top">

            <StackPanel x:Name="Root" Orientation="Horizontal">

            <StackPanel x:Name="CpuColumn" Orientation="Horizontal" VerticalAlignment="Center">
                <ContentControl x:Name="CpuHost" VerticalAlignment="Center" />
                <!-- Bottom aligned so the core bars share a baseline with a labelled gauge beside them. -->
                <StackPanel x:Name="CoreBars" Orientation="Horizontal" VerticalAlignment="Bottom" />
                <ContentControl x:Name="MemoryHost" VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel x:Name="NetColumn" Orientation="Vertical" Margin="22,0,0,0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" ToolTip="Network out">
                    <TextBlock x:Name="NetOutValue" Text="0 B/s" TextAlignment="Right" />
                    <TextBlock x:Name="NetOutArrow" Text="&#x25B2;" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" ToolTip="Network in">
                    <TextBlock x:Name="NetInValue" Text="0 B/s" TextAlignment="Right" />
                    <TextBlock x:Name="NetInArrow" Text="&#x25BC;" />
                </StackPanel>
            </StackPanel>

            <StackPanel x:Name="DiskColumn" Orientation="Vertical" Margin="22,0,0,0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" ToolTip="Storage read">
                    <TextBlock x:Name="DiskReadValue" Text="0 B/s" TextAlignment="Right" />
                    <TextBlock x:Name="DiskReadArrow" Text="&#x25B2;" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" ToolTip="Storage write">
                    <TextBlock x:Name="DiskWriteValue" Text="0 B/s" TextAlignment="Right" />
                    <TextBlock x:Name="DiskWriteArrow" Text="&#x25BC;" />
                </StackPanel>
            </StackPanel>

            <StackPanel x:Name="Circles"
                        Orientation="Horizontal"
                        Margin="16,0,0,0"
                        VerticalAlignment="Center" />
            </StackPanel>
        </Border>
    </StackPanel>
</Window>
