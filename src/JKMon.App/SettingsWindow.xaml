<Window x:Class="JKMon.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="JKMon Settings"
        Width="900"
        SizeToContent="Height"
        MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        Background="#FF1B1F27">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFE6EAF0" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FF8FA3BF" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,14,0,6" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#FF262C38" />
            <Setter Property="Foreground" Value="#FFE6EAF0" />
            <Setter Property="BorderBrush" Value="#FF3A4354" />
            <Setter Property="Padding" Value="4,3" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#FFE6EAF0" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="#FFE6EAF0" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,16,0" />
            <Style.Triggers>
                <!-- The explicit foreground above would otherwise hide the default disabled state. -->
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="#FF6B7688" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Swatch" TargetType="Button">
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="BorderBrush" Value="#FF3A4354" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="ToolTip" Value="Pick a colour" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#FFE6EAF0" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="16,12,16,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Two columns keep the window short enough that the buttons below stay reachable on laptop screens. -->
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="28" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">

                    <TextBlock Text="CUSTOM TEXT" Style="{StaticResource Heading}" Margin="0,0,0,6" />

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Caption" />
                        <TextBox Grid.Column="1" x:Name="CustomTextBox" MaxLength="64"
                                 ToolTip="Leave empty to hide the caption row" />
                    </Grid>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Caption font" />
                        <ComboBox Grid.Column="1" x:Name="CustomFontBox" IsEditable="False" MaxDropDownHeight="260" />
                    </Grid>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="44" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Caption size" />
                        <Slider Grid.Column="1" x:Name="CustomSizeSlider" Minimum="9" Maximum="72" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" x:Name="CustomSizeText" HorizontalAlignment="Right" />
                    </Grid>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="34" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Caption colour" />
                        <TextBox Grid.Column="1" x:Name="CustomColorBox" />
                        <Button Grid.Column="2" x:Name="CustomColorSwatch" Style="{StaticResource Swatch}" />
                    </Grid>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Caption align" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <RadioButton x:Name="CaptionLeftRadio" Content="Left" GroupName="Caption" />
                            <RadioButton x:Name="CaptionCenterRadio" Content="Centre" GroupName="Caption" />
                            <RadioButton x:Name="CaptionRightRadio" Content="Right" GroupName="Caption" />
                        </StackPanel>
                    </Grid>

                    <CheckBox x:Name="CaptionShadowCheck"
                              Content="Caption shadow"
                              ToolTip="캡션은 배경 밖에 있으므로 바탕화면 위에서 읽히려면 그림자가 필요하다"
                              Margin="110,0,0,8" />

                    <TextBlock Text="APPEARANCE" Style="{StaticResource Heading}" />

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="34" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Text colour" />
                        <TextBox Grid.Column="1" x:Name="TextColorBox" />
                        <Button Grid.Column="2" x:Name="TextColorSwatch" Style="{StaticResource Swatch}" />
                    </Grid>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="34" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Background" />
                        <TextBox Grid.Column="1" x:Name="BackColorBox" />
                        <Button Grid.Column="2" x:Name="BackColorSwatch" Style="{StaticResource Swatch}" />
                    </Grid>

                    <TextBlock Text="GAUGES" Style="{StaticResource Heading}" />

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="CPU" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <RadioButton x:Name="CpuNumberRadio" Content="Number" GroupName="CpuGauge" />
                            <RadioButton x:Name="CpuBarRadio" Content="Bar" GroupName="CpuGauge" />
                        </StackPanel>
                    </Grid>

                    <CheckBox x:Name="CoresCheck" Content="Show individual cores instead" Margin="110,0,0,8" />

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Memory" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <RadioButton x:Name="MemoryNumberRadio" Content="Number" GroupName="MemoryGauge" />
                            <RadioButton x:Name="MemoryBarRadio" Content="Bar" GroupName="MemoryGauge" />
                            <RadioButton x:Name="MemoryPieRadio" Content="Pie" GroupName="MemoryGauge" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="34" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Outline" />
                        <TextBox Grid.Column="1" x:Name="OutlineColorBox" />
                        <Button Grid.Column="2" x:Name="OutlineColorSwatch" Style="{StaticResource Swatch}" />
                    </Grid>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="44" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Outline width" />
                        <Slider Grid.Column="1" x:Name="OutlineWidthSlider" Minimum="0" Maximum="6" TickFrequency="0.5" IsSnapToTickEnabled="True" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" x:Name="OutlineWidthText" HorizontalAlignment="Right" />
                    </Grid>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="44" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Label size" ToolTip="Percentage shown above the bar and pie gauges" />
                        <Slider Grid.Column="1" x:Name="LabelSizeSlider" Minimum="6" Maximum="32" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" x:Name="LabelSizeText" HorizontalAlignment="Right" />
                    </Grid>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="44" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Caption size" ToolTip="CPU 와 Memory 이름을 숫자 게이지 위에 표시한다. 0 이면 숨긴다" />
                        <Slider Grid.Column="1" x:Name="CaptionSizeSlider" Minimum="0" Maximum="32" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" x:Name="CaptionSizeText" HorizontalAlignment="Right" />
                    </Grid>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="34" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="CPU usage" />
                        <TextBox Grid.Column="1" x:Name="CpuGaugeColorBox" />
                        <Button Grid.Column="2" x:Name="CpuGaugeColorSwatch" Style="{StaticResource Swatch}" />
                    </Grid>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="34" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Memory usage" />
                        <TextBox Grid.Column="1" x:Name="MemoryGaugeColorBox" />
                        <Button Grid.Column="2" x:Name="MemoryGaugeColorSwatch" Style="{StaticResource Swatch}" />
                    </Grid>

                    <TextBlock Text="INDICATORS" Style="{StaticResource Heading}" />

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="34" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Icon order" VerticalAlignment="Top" Margin="0,4,0,0" />
                        <ListBox Grid.Column="1"
                                 x:Name="OrderList"
                                 Height="66"
                                 Background="#FF262C38"
                                 Foreground="#FFE6EAF0"
                                 BorderBrush="#FF3A4354"
                                 ToolTip="Left to right order of the status icons. Only the clients running on this PC are listed" />
                        <TextBlock Grid.Column="1"
                                   x:Name="NoProvidersText"
                                   Visibility="Collapsed"
                                   Text="실행 중인 동기화 앱이 없습니다"
                                   Foreground="#FF8A93A6"
                                   VerticalAlignment="Top"
                                   Margin="0,4,0,0"
                                   TextWrapping="Wrap" />
                        <StackPanel Grid.Column="2" Orientation="Vertical" Margin="6,0,0,0">
                            <Button x:Name="OrderUpButton" Content="&#x25B2;" Height="30" ToolTip="Move earlier" />
                            <Button x:Name="OrderDownButton" Content="&#x25BC;" Height="30" Margin="0,6,0,0" ToolTip="Move later" />
                        </StackPanel>
                    </Grid>

                </StackPanel>

                <StackPanel Grid.Column="2">

                    <TextBlock Text="ACTIVITY BARS" Style="{StaticResource Heading}" Margin="0,0,0,6" />

                    <CheckBox x:Name="ActivityBarCheck"
                              Content="Name the Net and Disk columns and show how busy they are"
                              Margin="0,0,0,8" />

                    <StackPanel x:Name="ActivityRows">

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="34" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Idle" ToolTip="합산 전송량이 0일 때" />
                            <TextBox Grid.Column="1" x:Name="ActivityIdleColorBox" />
                            <Button Grid.Column="2" x:Name="ActivityIdleColorSwatch" Style="{StaticResource Swatch}" />
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="34" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Normal" ToolTip="1차 임계값 미만" />
                            <TextBox Grid.Column="1" x:Name="ActivityNormalColorBox" />
                            <Button Grid.Column="2" x:Name="ActivityNormalColorSwatch" Style="{StaticResource Swatch}" />
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="34" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Over 1st" ToolTip="1차 임계값 이상" />
                            <TextBox Grid.Column="1" x:Name="ActivityElevatedColorBox" />
                            <Button Grid.Column="2" x:Name="ActivityElevatedColorSwatch" Style="{StaticResource Swatch}" />
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="34" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Over 2nd" ToolTip="2차 임계값 이상" />
                            <TextBox Grid.Column="1" x:Name="ActivityHighColorBox" />
                            <Button Grid.Column="2" x:Name="ActivityHighColorSwatch" Style="{StaticResource Swatch}" />
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="34" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Net 1st KiB/s" ToolTip="네트워크 In+Out 합산 1차 임계값" />
                            <TextBox Grid.Column="1" x:Name="NetFirstThresholdBox" />
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="34" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Net 2nd KiB/s" />
                            <TextBox Grid.Column="1" x:Name="NetSecondThresholdBox" />
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="34" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Disk 1st KiB/s" ToolTip="스토리지 Read+Write 합산 1차 임계값" />
                            <TextBox Grid.Column="1" x:Name="DiskFirstThresholdBox" />
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="34" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Disk 2nd KiB/s" />
                            <TextBox Grid.Column="1" x:Name="DiskSecondThresholdBox" />
                        </Grid>

                    </StackPanel>

                    <TextBlock Text="TYPOGRAPHY" Style="{StaticResource Heading}" />

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="44" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Background opacity" TextWrapping="Wrap" />
                        <Slider Grid.Column="1" x:Name="OpacitySlider" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" x:Name="OpacityText" HorizontalAlignment="Right" />
                    </Grid>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Font" />
                        <ComboBox Grid.Column="1" x:Name="FontBox" IsEditable="False" MaxDropDownHeight="260" />
                    </Grid>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="44" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Font size" />
                        <Slider Grid.Column="1" x:Name="FontSizeSlider" Minimum="9" Maximum="32" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" x:Name="FontSizeText" HorizontalAlignment="Right" />
                    </Grid>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="44" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Indicator size" />
                        <Slider Grid.Column="1" x:Name="CircleSlider" Minimum="16" Maximum="64" TickFrequency="2" IsSnapToTickEnabled="True" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" x:Name="CircleText" HorizontalAlignment="Right" />
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="110,2,0,0">
                        <CheckBox x:Name="BoldCheck" Content="Bold" Margin="0,0,16,0" />
                        <CheckBox x:Name="ShadowCheck" Content="Text shadow" />
                    </StackPanel>

                    <TextBlock Text="BEHAVIOUR" Style="{StaticResource Heading}" />

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="44" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Refresh" />
                        <Slider Grid.Column="1" x:Name="RefreshSlider" Minimum="1" Maximum="10" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" x:Name="RefreshText" HorizontalAlignment="Right" />
                    </Grid>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="44" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Edge margin" />
                        <Slider Grid.Column="1" x:Name="MarginSlider" Minimum="0" Maximum="120" TickFrequency="2" IsSnapToTickEnabled="True" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" x:Name="MarginText" HorizontalAlignment="Right" />
                    </Grid>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Monitor" />
                        <ComboBox Grid.Column="1" x:Name="MonitorBox" IsEditable="False" MaxDropDownHeight="200" />
                    </Grid>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Position" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <RadioButton x:Name="BottomLeftRadio" Content="Left" GroupName="Position" />
                            <RadioButton x:Name="BottomCenterRadio" Content="Centre" GroupName="Position" />
                            <RadioButton x:Name="BottomRightRadio" Content="Right" GroupName="Position" />
                        </StackPanel>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Window layer" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <RadioButton x:Name="DesktopRadio" Content="Desktop" GroupName="Layer" />
                            <RadioButton x:Name="TopRadio" Content="Always on top" GroupName="Layer" />
                        </StackPanel>
                    </Grid>

                    <CheckBox x:Name="StartupCheck" Content="Start with Windows" Margin="110,10,0,0" />

                    <CheckBox x:Name="HideOnHoverCheck"
                              Content="Fade out while the mouse is over it"
                              ToolTip="Useful with Always on top so the overlay never covers what you are reading"
                              Margin="110,6,0,0" />

                    <CheckBox x:Name="FullscreenCheck"
                              Content="Hide and pause during full screen apps"
                              ToolTip="전체화면 영상이나 게임 중에는 오버레이를 숨기고 측정도 멈춰 자원을 쓰지 않는다"
                              Margin="110,6,0,0" />

                    <Grid Margin="0,10,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Update check" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <RadioButton x:Name="UpdateNeverRadio" Content="Never" GroupName="UpdateCheck" />
                            <RadioButton x:Name="UpdateDailyRadio" Content="Daily" GroupName="UpdateCheck" />
                            <RadioButton x:Name="UpdateWeeklyRadio" Content="Weekly" GroupName="UpdateCheck" />
                        </StackPanel>
                    </Grid>

                    <CheckBox x:Name="UpdateStartupCheck"
                              Content="Also check when the app starts"
                              ToolTip="주기와 상관없이 앱을 켤 때마다 확인한다"
                              Margin="110,0,0,0" />

                    <TextBlock x:Name="DataRootText"
                               Margin="110,6,0,0"
                               Foreground="#FF8FA3BF"
                               FontSize="11"
                               TextWrapping="Wrap" />

                </StackPanel>
            </Grid>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="ResetButton" Content="Reset" Width="80" Height="26" Margin="0,0,8,0" />
            <Button x:Name="CloseButton" Content="Close" Width="80" Height="26" IsDefault="True" />
        </StackPanel>
    </Grid>
</Window>
